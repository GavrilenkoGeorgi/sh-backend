{
  "name": "sh-backend",
  "version": "0.5.1",
  "description": "Sh backend.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx --ext ts,json src/index.ts",
    "build": "npx tsc",
    "start": "node build/index.js",
    "test-email": "npm run build && node -r dotenv/config build/utils/checkSmtpCreds.js",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit --skipLibCheck",
    "prepare": "husky"
  },
  "author": "jsm",
  "license": "UNLICENSED",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "nodemailer": "^8.0.10",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
    "eslint-plugin-jest": "^29.15.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.7",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "npx eslint --fix",
      "npx prettier --write"
    ],
    "*.ts": [
      "jest --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md}": [
      "npx prettier --write"
    ]
  }
}
